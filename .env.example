# ==============================================================================
# AI Research Assistant —— 环境变量配置模板 (.env.example)
# 复制本文件为 .env 并根据您的本地环境按需修改
# ==============================================================================

# 1. LLM 服务商配置
# 可选值: auto | openai | ollama | heuristic
# - auto: 优先检查 LLM_API_KEY (OpenAI 兼容接口)，其次尝试本地 Ollama，若均不可用则降级为原文启发式结构化提取
# - openai: 强制使用 OpenAI 兼容接口 (如 DeepSeek / SiliconFlow / OpenAI / OneAPI)
# - ollama: 强制使用本地 Ollama 模型 (默认适配 qwen3:4b)
# - heuristic: 仅使用基于原文规则与页码定位的确定性提取模式（无需 API Key 或 GPU）
LLM_PROVIDER=auto

# 2. OpenAI 兼容 API 配置 (仅在后端读取，切勿放入前端)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# 3. 本地 Ollama 配置 (适配本地已安装的 qwen3:4b，4GB 显存友好)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# 4. Embedding 与检索配置 (P1 论文智能问答)
# 可选值: none | bge-m3 | ollama | openai
# - none: 默认使用轻量级本地 BM25 + TF-IDF 页码分块检索（零模型下载、CPU 秒级响应）
# - bge-m3: 使用本地 HuggingFace 缓存的 BAAI/bge-m3 模型（自动检测本地缓存路径，不强制联网下载）
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=BAAI/bge-m3
HF_BGE_M3_CACHE_DIR=C:\Users\张伟强\.cache\huggingface\hub\models--BAAI--bge-m3

# 5. 数据库与存储配置
DATABASE_URL=sqlite:///./data/research_assistant.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=30

# 6. 服务端口与跨域配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
